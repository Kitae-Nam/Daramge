:root {
}

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-top-left {
    position: absolute;
    left: 32px;
    top: 32px;
}

.hud-top-right {
    position: absolute;
    right: 32px;
    top: 32px;
}

.hud-bottom-right {
    position: absolute;
    right: 32px;
    bottom: 32px;
}

.heart-container {
    flex-direction: row;
}

.heart-container {
    --heart-size: 40px;
    flex-direction: row;
}

.heart {
    width: var(--heart-size);  
    height: var(--heart-size); 
    margin-right: 4px;
    background-image: url("project://database/Assets/Members/CHG/05.Graphic/Images/Hollow_heart.png?fileID=2800000&guid=8c5cbc375411e9544bf422bdb9accbe4&type=3#Hollow_heart");
}

.heart__fill {          
    position: absolute; 
    left: 0;            
    top: 0;             
    bottom: 0;          
    overflow: hidden;   
}                       

.heart__fill-image {
    width: var(--heart-size);  
    height: var(--heart-size); 
    flex-shrink: 0;
    background-image: url("project://database/Assets/Members/CHG/05.Graphic/Images/Fill_heart.png?fileID=2800000&guid=8b52b309f90c0ec4399e27163de8e1f2&type=3#Fill_heart");
}

.minimap {
    width: 200px;
    height: 200px;
    background-color: rgba(0, 0, 0, 0.4);
}

.skill-container {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 32px;
    flex-direction: row;
    justify-content: center;
}

.skill-slot {
    width: 64px;
    height: 64px;
    margin: 0 4px;
    border-width: 2px;
    border-color: rgb(120, 100, 60);
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.6);
    overflow: hidden;
}

.skill-slot__icon,
.skill-slot__cooldown {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.skill-slot__cooldown {
    --overlay-color: rgba(0, 0, 0, 0.7);
}

.skill-slot__key {
    position: absolute;
    right: 3px;
    bottom: 1px;
    margin: 0;
    padding: 0;
    font-size: 14px;
    color: white;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: black;
}

.stamina-gauge {
    --fill-color: rgb(26, 242, 115);
    position: absolute;
    left: 0;
    top: 0;
    width: 64px;
    height: 64px;
    transition-property: opacity;
    transition-duration: 0.3s;
}

.stamina-gauge--low {
    --fill-color: rgb(230, 57, 70);
}

.stamina-gauge--hidden {
    opacity: 0;
}

.letterbox {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.letterbox__bar {
    position: absolute;
    left: 0;
    right: 0;
    transition-property: translate, height, background-color;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.letterbox__bar--top {
    top: 0;
    translate: 0 -100%;
}

.letterbox__bar--bottom {
    bottom: 0;
    translate: 0 100%;
}

.letterbox--visible > .letterbox__bar {
    translate: 0 0;
}

.screen-fade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: black;
    opacity: 0;
    transition-property: opacity;
    transition-timing-function: ease-in-out;
}

