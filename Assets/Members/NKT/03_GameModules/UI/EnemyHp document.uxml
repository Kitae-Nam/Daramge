<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Members/NKT/03_GameModules/UI/EnemyStatusStyle.uss?fileID=7433441132597879392&amp;guid=521dc1b4f630ff644a292e4770711c2f&amp;type=3#EnemyStatusStyle"/>
    <ui:VisualElement name="enemy-status" authoring-id="1707104262" style="flex-grow: 1;">
        <ui:VisualElement name="hp-bar" authoring-id="1387029304" class="status-bar__hp-bar">
            <ui:VisualElement name="hp-lag-fill" data-source="" class="hp-bar__lag-fill">
                <Bindings>
                    <ui:DataBinding property="style.scale" data-source-path="LagScale" binding-mode="ToTarget"/>
                </Bindings>
            </ui:VisualElement>
            <ui:VisualElement name="hp-fill" data-source="" class="hp-bar__fill">
                <Bindings>
                    <ui:DataBinding property="style.scale" data-source-path="FillScale" binding-mode="ToTarget"/>
                </Bindings>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
